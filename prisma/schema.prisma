// Data model for the 3P press manager. See CLAUDE.md → "Data model" and
// "Inventory / ledger rules" before changing anything here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum PaperStock {
  PRESS // "3P" on the job card
  CLIENT // "Clients" on the job card
}

enum JobStatus {
  CREATED
  COMPLETED
  CANCELLED
}

enum JobSection {
  A // Cover Paper
  B // Inside Color Paper
  C // Inside Paper
  D // Inside Paper
}

enum MovementType {
  RECEIPT
  JOB_ISSUE
  JOB_CORRECTION
  JOB_CANCEL
  ADJUSTMENT
}

model AllowedUser {
  id        String   @id @default(cuid())
  email     String   @unique // always lowercase
  name      String?
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A stock of paper. Press-owned (Paper – 3P) when clientKey is "", otherwise
// paper a client brought in (Paper – Client). Both use the same ledger.
model PaperType {
  id        String            @id @default(cuid())
  client    String? // client name as first entered; null for 3P stock
  clientKey String            @default("") // normalizeClient(client); "" for 3P stock
  category  String // A/B, A/P, W/F, DUP, TC, DB or free text
  gsm       Int
  size      String // normalized, e.g. "25x36" — see src/lib/paper.ts
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  movements StockMovement[]
  sections  JobPaperSection[]

  @@unique([clientKey, category, gsm, size])
}

// Paper stock ledger (3P and client paper). Append-only: never update or delete rows.
// Balance of a paper type = SUM(sheets).
model StockMovement {
  id             String       @id @default(cuid())
  paperTypeId    String
  paperType      PaperType    @relation(fields: [paperTypeId], references: [id])
  date           DateTime     @db.Date
  type           MovementType
  sheets         Int // signed: + into stock, − out of stock
  packets        Int? // record only, never used in calculations
  particulars    String?
  remarks        String?
  jobId          String?
  job            Job?         @relation(fields: [jobId], references: [id])
  createdByEmail String
  createdAt      DateTime     @default(now())

  @@index([paperTypeId, date])
  @@index([jobId])
}

model Job {
  id    String   @id @default(cuid())
  jobNo Int      @unique
  date  DateTime @db.Date

  // Job card header
  client          String
  jobName         String
  qty             Int?
  paperStock      PaperStock
  colorPlates     Int?
  bwPlates        Int?
  coverPlates     Int?
  spotPlates      Int?
  totalPlates     Int?
  lamination      String? // GLOSS | MATT | null
  laminationBSide Boolean    @default(false)
  laminationNote  String?
  binding         String? // CS | PB | SS | JUJU | OTHER | null
  bindingOther    String?
  other           String?
  repeatJob       Boolean    @default(false)
  repeatOfJobNo   Int? // as typed; not linked to another job

  // Shop-floor fields (free text, optional)
  providedBy     String?
  receivedBy     String?
  checkedBy      String?
  takenTime      String?
  completedBy    String?
  finalCheckedBy String?
  handoverTo     String?
  note           String?

  status JobStatus @default(CREATED)

  // Job Record-only fields, edited from the Job Records page (free text unless noted)
  recCol       Boolean @default(false) // tick
  recStitching String?
  recFolding   String?
  recLamQty    String?
  recLamSize   String?
  deliveryQty  String?
  remarks      String?

  // Ink Coverage: one photo or PDF in Vercel Blob, added from Job Records
  inkCoverageKind     String? // PHOTO | PDF | null
  inkCoverageUrl      String?
  inkCoverageThumbUrl String? // photos only
  inkCoverageAt       DateTime?
  inkCoverageByEmail  String?

  createdByEmail String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sections  JobPaperSection[]
  movements StockMovement[]

  @@index([date])
}

model JobPaperSection {
  id          String     @id @default(cuid())
  jobId       String
  job         Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  section     JobSection
  paperTypeId String? // the stock the Stock Paper sheets are taken from
  paperType   PaperType? @relation(fields: [paperTypeId], references: [id])
  category    String?
  gsm         Int?
  size        String? // job size: information only
  stockSize   String? // Stock Paper size: matched to the paper type
  stockSheets Int? // Stock Paper sheets: deducted from stock
  format      Int? // typed whole number
  folding     Int? // 1/2/4/8/16 (A) or up to 32 (B–D)
  printStyle  String? // OS | FB | WT | WTUMBLE
  frontColor  String?
  backColor   String?
  sheets      Int? // job sheets: information only
  wastage     Int? // extra sheets on top of the job sheets: information only
  withWastage Boolean    @default(false) // the job sheets already include wastage
  tally       Json? // string[] — sheet-tally boxes (UNKNOWN U9)

  @@unique([jobId, section])
}
