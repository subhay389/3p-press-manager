# Copy to .env and fill in. Never commit .env.

# Neon — POOLED connection string (Connection pooling ON; host contains "-pooler"). Used by the app.
DATABASE_URL=""
# Neon — DIRECT connection string (Connection pooling OFF). Used by Prisma CLI (migrate/seed/studio).
DIRECT_URL=""

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
AUTH_SECRET=""
# Google OAuth client (Google Cloud Console → Google Auth Platform → Clients)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# First admin, added by `npm run db:seed`
SEED_ADMIN_EMAIL="subhay389@gmail.com"
